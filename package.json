{
  "name": "online-go",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "在线围棋 - React + SQLite + WebSocket 本地对战系统",
  "scripts": {
    "build": "vite build --config client/vite.config.js",
