{
  "name": "online-go",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "在线围棋 - React + SQLite + WebSocket 在线对战系统（Bonto 托管适配）",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "vite build --config client/vite.config.js",
    "postbuild": "node scripts/build-info.js",
    "start": "node scripts/boot.js",
    "start:raw": "node server/index.js",
    "serve": "npm run build && node scripts/boot.js",
    "dev:client": "vite --config client/vite.config.js",
    "test": "node --no-warnings tests/protocol.test.js && node --no-warnings tests/db.test.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  }
}
